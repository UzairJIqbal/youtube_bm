{
	"manifest_version": 3,
	"name": "YouTube Study Bookmarks",
	"version": "1.0.1",
	"description": "Bookmark moments in YouTube lectures with one key, add notes, loop clips and export to Markdown or Obsidian.",
	"permissions": ["storage"],
	"host_permissions": ["https://www.youtube.com/*"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["https://www.youtube.com/*"],
			"js": ["contentScript.js"],
			"css": ["content.css"]
		}
	],
	"action": {
		"default_title": "YouTube Study Bookmarks",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"options_page": "options.html",
	"commands": {
		"add-bookmark": {
			"suggested_key": { "default": "Alt+B" },
			"description": "Bookmark the current moment"
		},
		"add-clip": {
			"suggested_key": { "default": "Alt+C" },
			"description": "Start or end a clip"
		}
	}
}
